# Copy to .env.development.local for local development (loaded ONLY by the dev server,
# never by production builds). All values are baked in at build time.
# Leave unset to use the production endpoints defined in src/config.ts.

# Review-sharing API (backend/review)
VITE_REVIEW_API_URL=http://localhost:3001

# Portfolio persistence API (backend/userdata)
VITE_USERDATA_API_URL=http://localhost:3001

# AI proxy. "/api/ai" is proxied by the Vite dev server to a local Ollama.
VITE_AI_API_URL=/api/ai
VITE_AI_MODEL=llama3

# Dev-only identity (ignored in production builds). Enables cloud sync against the local harness.
VITE_DEV_USER=alice

# Skip the Harmony navbar (needs Midway) for standalone/headless local runs
VITE_SKIP_HARMONY_NAVBAR=1
